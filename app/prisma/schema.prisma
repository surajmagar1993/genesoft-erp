}

model PriceListItem {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  priceListId     String      @map("price_list_id") @db.Uuid
  productId       String      @map("product_id") @db.Uuid
  
  minQuantity     Decimal     @default(1) @map("min_quantity") @db.Decimal(15, 2) // Volume tier (e.g. 1, 10, 50, 100)
  customPrice     Decimal?    @map("custom_price") @db.Decimal(15, 2) // Fixed unit price override
