  @@index([tenantId])
  @@index([creditNoteId])
  @@index([productId])
  @@index([warehouseId])
  @@map("credit_note_items")
}

model CreditNoteRefund {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  creditNoteId  String      @map("credit_note_id") @db.Uuid
  amount        Decimal     @db.Decimal(15, 2)
  refundDate    DateTime    @default(now()) @map("refund_date")
  paymentMethod String      @default("BANK_TRANSFER") @map("payment_method")
