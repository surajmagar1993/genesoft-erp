// Prisma Schema for Genesoft ERP & CRM
// Multi-tenant SaaS with Row-Level Security

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // url and directUrl are now configured in prisma.config.ts for Prisma v7
}

// ============================================
// MULTI-TENANT CORE
// ============================================

model Tenant {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  domain          String?  @unique
  countryCode     String   @default("IN") @map("country_code")
  currencyCode    String   @default("INR") @map("currency_code")
  plan            Plan     @default(FREE)
  settings        Json     @default("{}")
  logoUrl         String?  @map("logo_url")
  address         Json?
  phone           String?
  email           String?
  website         String?
  fiscalYearStart Int      @default(4) @map("fiscal_year_start") // April for India
  isActive        Boolean  @default(true) @map("is_active")
  
  // SaaS Billing Extensions
  isTrial         Boolean  @default(true) @map("is_trial")
  trialEndsAt     DateTime? @map("trial_ends_at")
  billingRegion   String?   @map("billing_region") // e.g. IN, US, AE, SA
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Stripe Billing IDs
  stripeCustomerId      String? @unique @map("stripe_customer_id")
  stripeSubscriptionId  String? @unique @map("stripe_subscription_id")

  // Relations
  users       User[]
  contacts    Contact[]
  products    Product[]
  invoices    Invoice[]
  quotes      Quote[]
  salesOrders SalesOrder[]
  taxGroups   TaxGroup[]
  tasks              Task[]
  payments           Payment[]
  communicationLogs  CommunicationLog[]
  accounts           Account[]
  bills              Bill[]
  notifications      Notification[]
  
  // Platform Support
  supportTickets     SupportTicket[]
  systemLogs         SystemLog[]
  ledgerEntries      LedgerEntry[]
  warehouses         Warehouse[]
  warehouseStocks    WarehouseStock[]
  stockMovements     StockMovement[]
  purchaseOrders     PurchaseOrder[]
  departments        Department[]
  designations       Designation[]
  employees          Employee[]
  attendances        Attendance[]
  leaves             Leave[]
  projects           Project[]
  projectMembers     ProjectMember[]
  projectMilestones  ProjectMilestone[]
  projectTasks       ProjectTask[]
  projectTimeEntries ProjectTimeEntry[]
  rentalAssets       RentalAsset[]
  rentalAgreements   RentalAgreement[]
  rentalAgreementItems RentalAgreementItem[]
  rentalReturns      RentalReturn[]
  creditNotes        CreditNote[]
  creditNoteItems    CreditNoteItem[]
  creditNoteRefunds  CreditNoteRefund[]
  expenses           Expense[]
  journalEntries     JournalEntry[]
  journalEntryLines  JournalEntryLine[]
  priceLists         PriceList[]
  priceListItems     PriceListItem[]
  bankAccounts       BankAccount[]
  bankStatements     BankStatement[]
  bankTransactions   BankTransaction[]
  recurringProfiles  RecurringProfile[]
  recurringProfileItems RecurringProfileItem[]
  recurringExecutions RecurringExecution[]
  emailAccounts      EmailAccount[]
  emailMessages      EmailMessage[]
  emailTemplates     EmailTemplate[]
  webForms           WebForm[]
  formSubmissions    FormSubmission[]
  portalTickets      PortalTicket[]
  posSessions        POSSession[]
  salaryStructures   SalaryStructure[]
  payrollRuns        PayrollRun[]
  payslips           Payslip[]
  boms               BillOfMaterials[]
  workOrders         WorkOrder[]
  qualityInspections QualityInspection[]
  jobOpenings        JobOpening[]
  jobApplicants      JobApplicant[]
  applicantInterviews ApplicantInterview[]
  deliveryChallans   DeliveryChallan[]

  @@map("tenants")
}

enum Plan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

model User {
  id        String   @id @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  role      Role     @default(USER)
  fullName  String?  @map("full_name")
  email     String   @unique
  phone     String?
  avatarUrl String?  @map("avatar_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  employee Employee?

  @@map("profiles")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  USER
  VIEWER
}

// ============================================
// CRM & CONTACTS
// ============================================

model Contact {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  type          ContactType @default(INDIVIDUAL)
  customerGroup String?     @map("customer_group") // retail, wholesale, vip

  // Basic Info
  firstName   String? @map("first_name")
  lastName    String? @map("last_name")
  companyName String? @map("company_name")
  displayName String  @map("display_name")
  email       String?
  phone       String?
  mobile      String?
  website     String?

  // Address
  billingAddress  Json? @map("billing_address")
  shippingAddress Json? @map("shipping_address")

  // India Identifiers
  gstin     String? // GST Number
  pan       String? // PAN Card
  cin       String? // Corporate ID
  tan       String? // TDS Account
  msmeUdyam String? @map("msme_udyam")

  // UAE Identifiers
  trn          String? // Tax Registration Number
  tradeLicense String? @map("trade_license")

  // Saudi Arabia Identifiers
  vatNumberKsa String? @map("vat_number_ksa")
  crNumber     String? @map("cr_number")

  // USA Identifiers
  ein String? // Employer ID

  // Generic
  taxNumber   String? @map("tax_number")
  countryCode String? @map("country_code")

  // Tax Exemption
  isTaxExempt             Boolean @default(false) @map("is_tax_exempt")
  taxExemptionReason      String? @map("tax_exemption_reason")
  taxExemptionCertificate String? @map("tax_exemption_certificate")

  // Financial
  currencyCode String   @default("INR") @map("currency_code")
  creditLimit  Decimal? @map("credit_limit") @db.Decimal(15, 2)
  balance      Decimal  @default(0) @db.Decimal(15, 2)

  // Portal Access
  portalEnabled    Boolean   @default(false) @map("portal_enabled")
  portalToken      String?   @unique @map("portal_token")
  portalLastAccess DateTime? @map("portal_last_access")

  // Meta
  tags      Json     @default("[]")
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  tasks              Task[]
  leads              Lead[]
  deals              Deal[]
  invoices           Invoice[]
  quotes             Quote[]
  salesOrders        SalesOrder[]
  payments           Payment[]
  bills              Bill[]
  communicationLogs  CommunicationLog[]
  ledgerEntries      LedgerEntry[]
  purchaseOrders     PurchaseOrder[]
  projects           Project[]
  rentalAgreements   RentalAgreement[]
  creditNotes        CreditNote[]
  expenses           Expense[]
  journalEntryLines  JournalEntryLine[]

  priceListId        String?            @map("price_list_id") @db.Uuid
  priceList          PriceList?         @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  recurringProfiles  RecurringProfile[]
  emailMessages      EmailMessage[]
  formSubmissions    FormSubmission[]
  portalTickets      PortalTicket[]
  deliveryChallans   DeliveryChallan[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, gstin])
  @@index([tenantId, priceListId])
  @@index([portalToken])
  @@map("contacts")
}

enum ContactType {
  INDIVIDUAL
  COMPANY
}

model Lead {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  contactId   String?    @map("contact_id") @db.Uuid
  title       String
  source      String? // web_form, referral, cold_call
  status      LeadStatus @default(NEW)
  score       Int        @default(0)
  assignedTo  String?    @map("assigned_to")
  notes       String?
  convertedTo String?    @map("converted_to") // deal_id
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  contact           Contact?           @relation(fields: [contactId], references: [id])
  tasks             Task[]
  communicationLogs CommunicationLog[]
  emailMessages     EmailMessage[]
  formSubmissions   FormSubmission[]

  @@index([tenantId])
  @@map("leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

model Deal {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  contactId         String    @map("contact_id") @db.Uuid
  title             String
  value             Decimal?  @db.Decimal(15, 2)
  currency          String    @default("INR")
  stage             DealStage @default(PROSPECTING)
  probability       Int       @default(0) // 0-100
  expectedCloseDate DateTime? @map("expected_close_date")
  assignedTo        String?   @map("assigned_to")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  contact           Contact            @relation(fields: [contactId], references: [id])
  tasks             Task[]
  communicationLogs CommunicationLog[]
  emailMessages     EmailMessage[]

  @@index([tenantId])
  @@map("deals")
}

enum DealStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

// ============================================
// PRODUCTS & SERVICES
// ============================================

model Product {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  type             ProductType @default(PRODUCT)
  name             String
  category         String?
  brand            String?
  modelNo          String?     @map("model_no")
  serialNo         String?     @map("serial_no")
  sku              String?
  hsnSacCode       String?     @map("hsn_sac_code")
  description      String?
  customAttributes Json?       @default("{}") @map("custom_attributes")
  unitPrice        Decimal     @default(0) @db.Decimal(15, 2)
  currency         String      @default("INR")
  unit             String      @default("Nos") // Nos, Kg, Ltr, Hr, etc.
  taxGroupId       String?     @map("tax_group_id") @db.Uuid
  stockQty         Decimal     @default(0) @map("stock_qty") @db.Decimal(15, 2)
  imageUrl         String?     @map("image_url")
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  taxGroup        TaxGroup?        @relation(fields: [taxGroupId], references: [id])
  invoiceItems    InvoiceItem[]
  billItems       BillItem[]
  warehouseStocks    WarehouseStock[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  creditNoteItems    CreditNoteItem[]
  priceListItems     PriceListItem[]
  recurringProfileItems RecurringProfileItem[]
  bomsAsFinishedGood    BillOfMaterials[]     @relation("ProductBOMs")
  bomItemsAsComponent   BillOfMaterialsItem[] @relation("ProductBOMComponents")
  workOrders            WorkOrder[]           @relation("ProductWorkOrders")
  deliveryChallanItems  DeliveryChallanItem[]

  @@index([tenantId])
  @@index([tenantId, sku])
  @@map("products")
}

enum ProductType {
  PRODUCT
  SERVICE
}

// ============================================
// INVENTORY & WAREHOUSES
// ============================================

model Warehouse {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  code         String
  address      String?
  city         String?
  state        String?
  country      String?  @default("India")
  contactName  String?  @map("contact_name")
  contactPhone String?  @map("contact_phone")
  isDefault    Boolean  @default(false) @map("is_default")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  warehouseStocks WarehouseStock[]
  movementsFrom   StockMovement[]  @relation("SourceWarehouse")
  movementsTo     StockMovement[]  @relation("DestinationWarehouse")
  purchaseOrders  PurchaseOrder[]
  rentalAssets    RentalAsset[]
  creditNoteItems CreditNoteItem[]
  workOrdersSource WorkOrder[]      @relation("WorkOrderSourceWarehouse")
  workOrdersTarget WorkOrder[]      @relation("WorkOrderTargetWarehouse")
  deliveryChallans DeliveryChallan[] @relation("WarehouseDeliveryChallans")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

model WarehouseStock {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  warehouseId  String   @map("warehouse_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  quantity     Decimal  @default(0) @db.Decimal(15, 2)
  reorderPoint Decimal  @default(10) @map("reorder_point") @db.Decimal(15, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([tenantId])
  @@index([productId])
  @@map("warehouse_stocks")
}

model StockMovement {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  warehouseId   String            @map("warehouse_id") @db.Uuid
  toWarehouseId String?           @map("to_warehouse_id") @db.Uuid
  type          StockMovementType
  quantity      Decimal           @db.Decimal(15, 2)
  previousQty   Decimal           @map("previous_qty") @db.Decimal(15, 2)
  newQty        Decimal           @map("new_qty") @db.Decimal(15, 2)
  reason        String?
  referenceNo   String?           @map("reference_no")
  performedBy   String?           @map("performed_by")
  createdAt     DateTime          @default(now()) @map("created_at")

  tenant               Tenant     @relation(fields: [tenantId], references: [id])
  product              Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceWarehouse      Warehouse  @relation("SourceWarehouse", fields: [warehouseId], references: [id], onDelete: Cascade)
  destinationWarehouse Warehouse? @relation("DestinationWarehouse", fields: [toWarehouseId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([productId])
  @@index([warehouseId])
  @@map("stock_movements")
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  DAMAGE
  RETURN
}

// ============================================
// TAX ENGINE
// ============================================

model TaxGroup {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String // "GST 18%", "UAE VAT 5%", "Zero Rated"
  countryCode String   @map("country_code")
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  taxRates TaxRate[]
  products Product[]

  @@index([tenantId])
  @@map("tax_groups")
}

model TaxRate {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taxGroupId String  @map("tax_group_id") @db.Uuid
  name       String // "CGST", "SGST", "IGST", "VAT"
  rate       Decimal @db.Decimal(5, 2) // percentage
  isActive   Boolean @default(true) @map("is_active")

  taxGroup TaxGroup @relation(fields: [taxGroupId], references: [id])

  @@map("tax_rates")
}

// ============================================
// INVOICING
// ============================================

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String        @map("tenant_id") @db.Uuid
  contactId     String        @map("contact_id") @db.Uuid
  invoiceNumber String        @map("invoice_number")
  type          InvoiceType   @default(TAX_INVOICE)
  status        InvoiceStatus @default(DRAFT)

  // Dates
  invoiceDate DateTime  @default(now()) @map("invoice_date")
  dueDate     DateTime? @map("due_date")

  // Addresses
  billTo        Json    @map("bill_to")
  shipTo        Json?   @map("ship_to")
  placeOfSupply String? @map("place_of_supply")

  // Amounts
  subtotal     Decimal @default(0) @db.Decimal(15, 2)
  taxAmount    Decimal @default(0) @map("tax_amount") @db.Decimal(15, 2)
  discount     Decimal @default(0) @db.Decimal(15, 2)
  total        Decimal @default(0) @db.Decimal(15, 2)
  totalInWords String? @map("total_in_words")
  currencyCode String  @default("INR") @map("currency_code")

  // Tax Summary & Exemption
  taxSummary              Json?   @map("tax_summary") // HSN/SAC breakup table
  isTaxExempt             Boolean @default(false) @map("is_tax_exempt")
  taxExemptionReason      String? @map("tax_exemption_reason")
  taxExemptionCertificate String? @map("tax_exemption_certificate")

  // Payment & Terms
  paymentTerms String? @map("payment_terms")
  bankDetails  Json?   @map("bank_details")
  notes        String?
  terms        String?

  // Files
  signatureUrl String? @map("signature_url")
  pdfUrl       String? @map("pdf_url")

  // Meta
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  contact  Contact       @relation(fields: [contactId], references: [id])
  items       InvoiceItem[]
  payments    Payment[]
  creditNotes CreditNote[]
  recurringProfileId String?            @map("recurring_profile_id") @db.Uuid
  recurringProfile   RecurringProfile?  @relation(fields: [recurringProfileId], references: [id], onDelete: SetNull)
  recurringExecutions RecurringExecution[]
  convertedChallans   DeliveryChallan[]   @relation("InvoiceConvertedChallan")

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([recurringProfileId])
  @@map("invoices")
}

enum InvoiceType {
  TAX_INVOICE
  PROFORMA
  CREDIT_NOTE
  DEBIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoice_id")
  productId   String? @map("product_id") @db.Uuid
  description String
  hsnSacCode  String? @map("hsn_sac_code")
  quantity    Decimal @db.Decimal(15, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(15, 2)

  // Tax breakdown
  cgstRate   Decimal? @map("cgst_rate") @db.Decimal(5, 2)
  cgstAmount Decimal? @map("cgst_amount") @db.Decimal(15, 2)
  sgstRate   Decimal? @map("sgst_rate") @db.Decimal(5, 2)
  sgstAmount Decimal? @map("sgst_amount") @db.Decimal(15, 2)
  igstRate   Decimal? @map("igst_rate") @db.Decimal(5, 2)
  igstAmount Decimal? @map("igst_amount") @db.Decimal(15, 2)
  vatRate    Decimal? @map("vat_rate") @db.Decimal(5, 2)
  vatAmount  Decimal? @map("vat_amount") @db.Decimal(15, 2)

  // Totals & Exemption
  isExempt  Boolean @default(false) @map("is_exempt")
  discount  Decimal @default(0) @db.Decimal(15, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(15, 2)

  // Relations
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@map("invoice_line_items")
}

// ============================================
// QUOTATIONS
// ============================================

model Quote {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  contactId   String?     @map("contact_id") @db.Uuid // Optional link to contact
  quoteNumber String      @map("quote_number")
  status      QuoteStatus @default(DRAFT)

  // Basic Info
  customerName  String    @map("customer_name")
  customerEmail String    @map("customer_email")
  quoteDate     DateTime  @default(now()) @map("quote_date")
  validUntil    DateTime? @map("valid_until")
  reference     String?

  // Amounts
  subtotal     Decimal      @default(0) @db.Decimal(15, 2)
  taxAmount    Decimal      @default(0) @map("tax_amount") @db.Decimal(15, 2)
  discount     Decimal      @default(0) @db.Decimal(15, 2)
  discountType DiscountType @default(PERCENT) @map("discount_type")
  total        Decimal      @default(0) @db.Decimal(15, 2)
  currencyCode String       @default("INR") @map("currency_code")

  // Terms & Notes
  notes              String?
  termsAndConditions String? @map("terms_and_conditions")

  // Meta
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  contact     Contact?     @relation(fields: [contactId], references: [id])
  items       QuoteItem[]
  salesOrders SalesOrder[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("quotes")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum DiscountType {
  PERCENT
  FIXED
}

model QuoteItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId     String  @map("quote_id") @db.Uuid
  productName String  @map("product_name")
  description String?
  qty         Decimal @db.Decimal(15, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(15, 2)
  taxPercent  Decimal @default(18) @map("tax_percent") @db.Decimal(5, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(15, 2)

  // Relations
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_items")
}

// ============================================
// TASKS & ACTIVITIES
// ============================================

model Task {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date")
  assignedTo  String?      @map("assigned_to") @db.Uuid

  // Relations to entities
  contactId String? @map("contact_id") @db.Uuid
  leadId    String? @map("lead_id") @db.Uuid
  dealId    String? @map("deal_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  lead    Lead?    @relation(fields: [leadId], references: [id])
  deal    Deal?    @relation(fields: [dealId], references: [id])

  @@index([tenantId])
  @@index([contactId])
  @@index([leadId])
  @@index([dealId])
  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ============================================
// SALES ORDERS
// ============================================

model SalesOrder {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  contactId   String?          @map("contact_id") @db.Uuid
  orderNumber String           @map("order_number")
  status      SalesOrderStatus @default(DRAFT)

  // Basic Info
  customerName  String    @map("customer_name")
  customerEmail String    @map("customer_email")
  orderDate     DateTime  @default(now()) @map("order_date")
  expectedDate  DateTime? @map("expected_date")
  reference     String?

  // Amounts
  subtotal     Decimal      @default(0) @db.Decimal(15, 2)
  taxAmount    Decimal      @default(0) @map("tax_amount") @db.Decimal(15, 2)
  discount     Decimal      @default(0) @db.Decimal(15, 2)
  discountType DiscountType @default(PERCENT) @map("discount_type")
  total        Decimal      @default(0) @db.Decimal(15, 2)
  currencyCode String       @default("INR") @map("currency_code")

  // Terms & Notes
  notes              String?
  termsAndConditions String? @map("terms_and_conditions")

  // Linking
  quoteId String? @map("quote_id") @db.Uuid

  // Meta
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  contact Contact?         @relation(fields: [contactId], references: [id])
  quote   Quote?           @relation(fields: [quoteId], references: [id])
  items   SalesOrderItem[]
  deliveryChallans DeliveryChallan[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("sales_orders")
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model SalesOrderItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  productName String  @map("product_name")
  description String?
  qty         Decimal @db.Decimal(15, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(15, 2)
  taxPercent  Decimal @default(18) @map("tax_percent") @db.Decimal(5, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(15, 2)

  // Relations
  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("sales_order_items")
}

// ============================================
// PAYMENTS & FINANCE
// ============================================

model Payment {
  id            String        @id @default(cuid())
  tenantId      String        @map("tenant_id") @db.Uuid
  invoiceId     String?       @map("invoice_id")
  billId        String?       @map("bill_id") @db.Uuid
  contactId     String        @map("contact_id") @db.Uuid
  
  amount        Decimal       @db.Decimal(15, 2)
  paymentDate   DateTime      @default(now()) @map("payment_date")
  paymentMethod PaymentMethod @default(BANK_TRANSFER) @map("payment_method")
  type          PaymentType   @default(INBOUND)
  reference     String?
  notes         String?
  currencyCode  String        @default("INR") @map("currency_code")

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bill          Bill?         @relation(fields: [billId], references: [id], onDelete: Cascade)
  contact       Contact       @relation(fields: [contactId], references: [id])
  bankTransactions BankTransaction[]

  @@index([tenantId])
  @@index([invoiceId])
  @@index([billId])
  @@index([contactId])
  @@map("payments")
}

enum PaymentType {
  INBOUND
  OUTBOUND
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  UPI
  CHEQUE
  STRIPE
  PAYPAL
  OTHER
}

// ============================================
// ACCOUNTS PAYABLE (BILLS)
// ============================================

model Bill {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  contactId  String     @map("contact_id") @db.Uuid // Vendor
  billNumber String     @map("bill_number")
  status     BillStatus @default(DRAFT)

  // Dates
  billDate DateTime  @default(now()) @map("bill_date")
  dueDate  DateTime? @map("due_date")

  // Amounts
  subtotal     Decimal @default(0) @db.Decimal(15, 2)
  taxAmount    Decimal @default(0) @map("tax_amount") @db.Decimal(15, 2)
  discount     Decimal @default(0) @db.Decimal(15, 2)
  total        Decimal @default(0) @db.Decimal(15, 2)
  currencyCode String  @default("INR") @map("currency_code")

  // Meta
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  contact  Contact    @relation(fields: [contactId], references: [id])
  items          BillItem[]
  payments       Payment[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, billNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("bills")
}

enum BillStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

model BillItem {
  id          String  @id @default(cuid())
  billId      String  @map("bill_id") @db.Uuid
  productId   String? @map("product_id") @db.Uuid
  description String
  hsnSacCode  String? @map("hsn_sac_code")
  quantity    Decimal @db.Decimal(15, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(15, 2)

  // Tax breakdown
  taxPercent Decimal @default(0) @map("tax_percent") @db.Decimal(5, 2)
  taxAmount  Decimal @default(0) @map("tax_amount") @db.Decimal(15, 2)

  // Totals
  lineTotal Decimal @map("line_total") @db.Decimal(15, 2)

  // Relations
  bill    Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@map("bill_items")
}

// ============================================
// PROCUREMENT & PURCHASE ORDERS
// ============================================

model PurchaseOrder {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String              @map("tenant_id") @db.Uuid
  vendorId             String              @map("vendor_id") @db.Uuid
  warehouseId          String?             @map("warehouse_id") @db.Uuid
  billId               String?             @map("bill_id") @db.Uuid
  orderNumber          String              @map("order_number")
  status               PurchaseOrderStatus @default(DRAFT)
  orderDate            DateTime            @default(now()) @map("order_date")
  expectedDeliveryDate DateTime?           @map("expected_delivery_date")

  // Amounts
  subtotal     Decimal @default(0) @db.Decimal(15, 2)
  taxAmount    Decimal @default(0) @map("tax_amount") @db.Decimal(15, 2)
  discount     Decimal @default(0) @db.Decimal(15, 2)
  total        Decimal @default(0) @db.Decimal(15, 2)
  currencyCode String  @default("INR") @map("currency_code")

  // Meta
  notes     String?
  terms     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  vendor    Contact             @relation(fields: [vendorId], references: [id])
  warehouse Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  bill      Bill?               @relation(fields: [billId], references: [id], onDelete: SetNull)
  items     PurchaseOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  productId       String? @map("product_id") @db.Uuid
  description     String
  hsnSacCode      String? @map("hsn_sac_code")
  quantity        Decimal @db.Decimal(15, 2)
  receivedQty     Decimal @default(0) @map("received_qty") @db.Decimal(15, 2)
  unitPrice       Decimal @map("unit_price") @db.Decimal(15, 2)
  taxPercent      Decimal @default(0) @map("tax_percent") @db.Decimal(5, 2)
  taxAmount       Decimal @default(0) @map("tax_amount") @db.Decimal(15, 2)
  lineTotal       Decimal @map("line_total") @db.Decimal(15, 2)

  // Relations
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("purchase_order_items")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// ============================================
// CHART OF ACCOUNTS
// ============================================

model Account {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  code         String      // e.g. "1000", "2100"
  name         String      // e.g. "Cash", "Accounts Receivable"
  type         AccountType
  parentId     String?     @map("parent_id") @db.Uuid
  isGroup      Boolean     @default(false) @map("is_group")
  description  String?
  balance      Decimal     @default(0) @db.Decimal(15, 2)
  currencyCode String      @default("INR") @map("currency_code")
  isActive     Boolean     @default(true) @map("is_active")
  isSystem     Boolean     @default(false) @map("is_system") // system accounts can't be deleted
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  parent       Account?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     Account[]   @relation("AccountHierarchy")

  // Expenses & General Ledger
  expensesAsExpense  Expense[]          @relation("ExpenseAccount")
  expensesAsPayment  Expense[]          @relation("PaymentAccount")
  journalEntryLines  JournalEntryLine[]
  bankAccounts       BankAccount[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
  @@index([type])
  @@map("accounts")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

// ============================================
// COMMUNICATION LOG
// ============================================

model CommunicationLog {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  type      CommunicationType @default(NOTE)
  subject   String?
  content   String
  loggedAt  DateTime          @default(now()) @map("logged_at")
  loggedBy  String?           @map("logged_by") // user name or id

  // Polymorphic entity links
  contactId String? @map("contact_id") @db.Uuid
  leadId    String? @map("lead_id") @db.Uuid
  dealId    String? @map("deal_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  lead    Lead?    @relation(fields: [leadId], references: [id])
  deal    Deal?    @relation(fields: [dealId], references: [id])

  @@index([tenantId])
  @@index([contactId])
  @@index([leadId])
  @@index([dealId])
  @@map("communication_logs")
}

enum CommunicationType {
  NOTE
  EMAIL
  CALL
  MEETING
  TASK
}

// ============================================
// SaaS PLATFORM & SUPER ADMIN
// ============================================

model PricingPlan {
  id         String   @id @default(cuid())
  regionCode String   @map("region_code") // IN, US, AE, SA, UK, AU
  tier       Plan
  amount     Decimal  @map("price") @db.Decimal(15, 2)
  currency   String   @default("INR")
  gateway    String   @default("RAZORPAY") // RAZORPAY or STRIPE
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([regionCode, tier])
  @@map("pricing_plans")
}

model SystemLog {
  id        String   @id @default(cuid())
  tenantId  String?  @map("tenant_id") @db.Uuid
  level     LogLevel @default(INFO)
  message   String
  path      String?
  stack     String?
  timestamp DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([level])
  @@map("system_logs")
}

model ProcessedStripeEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([eventId])
  @@map("processed_stripe_events")
}

enum LogLevel {
  INFO
  WARN
  ERROR
  FATAL
}

model SupportTicket {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id") @db.Uuid
  subject   String
  status    TicketStatus @default(OPEN)
  priority  TaskPriority @default(MEDIUM)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  messages SupportMessage[]

  @@index([tenantId])
  @@map("support_tickets")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportMessage {
  id          String   @id @default(cuid())
  ticketId    String   @map("ticket_id")
  senderId    String   @map("sender_id") // user_id or admin_id
  content     String
  isFromAdmin Boolean  @default(false) @map("is_from_admin")
  createdAt   DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_messages")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id          String   @id @default(cuid())
  type        String   // lead, deal, quote, bill, system
  title       String
  description String?
  link        String?  // Optional link to the related entity
  isRead      Boolean  @default(false) @map("is_read")
  userId      String   @map("user_id") // Recipient user ID
  tenantId    String   @map("tenant_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([userId, tenantId])
  @@map("notifications")
}

// ============================================
// FINANCIAL LEDGER
// ============================================

model LedgerEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  contactId   String   @map("contact_id") @db.Uuid
  
  type        LedgerEntryType
  amount      Decimal  @db.Decimal(15, 2)
  balance     Decimal  @db.Decimal(15, 2)
  
  currencyCode String   @default("INR") @map("currency_code")
  
  referenceId String?  @map("reference_id")
  description String?
  date        DateTime @default(now())
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  contact     Contact  @relation(fields: [contactId], references: [id])

  @@index([tenantId, contactId])
  @@map("ledger_entries")
}

// ============================================
// EXCHANGE RATE CACHE
// ============================================

model ExchangeRateCache {
  id           String   @id @default(cuid())
  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  rate         Decimal  @db.Decimal(15, 6)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([fromCurrency, toCurrency])
  @@map("exchange_rate_cache")
}

enum LedgerEntryType {
  INVOICE
  PAYMENT
  CREDIT_NOTE
  REFUND
  OPENING_BALANCE
}

// ============================================
// SUPER ADMIN GOVERNANCE
// ============================================

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String   @map("admin_id") // User ID of the admin
  adminEmail  String   @map("admin_email")
  action      String   // e.g. "TENANT_SUSPEND", "PRICE_UPDATE", "SUPPORT_CLOSE"
  targetId    String?  @map("target_id") // ID of affected entity
  targetType  String?  @map("target_type") // e.g. "TENANT", "USER", "PRICING"
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([action])
  @@map("admin_audit_logs")
}

model GlobalSettings {
  id              String   @id @default("system_config")
  maintenanceMode Boolean  @default(false) @map("maintenance_mode")
  allowSignups    Boolean  @default(true) @map("allow_signups")
  bannerMessage   String?  @map("banner_message")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("global_settings")
}

// ============================================
// HR & WORKFORCE MANAGEMENT
// ============================================

model Department {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  code        String?
  description String?
  managerId   String?  @map("manager_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manager      Employee?     @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  employees    Employee[]    @relation("DepartmentEmployees")
  designations Designation[]
  jobOpenings  JobOpening[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
}

model Designation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  departmentId String?  @map("department_id") @db.Uuid
  title        String
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees   Employee[]
  jobOpenings JobOpening[]

  @@unique([tenantId, title])
  @@index([tenantId])
  @@index([departmentId])
  @@map("designations")
}

model Employee {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  userId           String?        @unique @map("user_id") @db.Uuid
  employeeNumber   String         @map("employee_number")
  firstName        String         @map("first_name")
  lastName         String?        @map("last_name")
  displayName      String         @map("display_name")
  email            String
  phone            String?
  dateOfBirth      DateTime?      @map("date_of_birth")
  gender           String?
  joiningDate      DateTime       @default(now()) @map("joining_date")
  status           EmployeeStatus @default(ACTIVE)
  employmentType   EmploymentType @default(FULL_TIME) @map("employment_type")
  
  departmentId     String?        @map("department_id") @db.Uuid
  designationId    String?        @map("designation_id") @db.Uuid
  managerId        String?        @map("manager_id") @db.Uuid
  salaryStructureId String?       @map("salary_structure_id") @db.Uuid
  
  basicSalary      Decimal?       @map("basic_salary") @db.Decimal(15, 2)
  currencyCode     String         @default("INR") @map("currency_code")
  bankDetails      Json?          @map("bank_details")
  address          Json?
  emergencyContact Json?          @map("emergency_contact")
  
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Relations
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  department         Department?    @relation("DepartmentEmployees", fields: [departmentId], references: [id], onDelete: SetNull)
  designation        Designation?   @relation(fields: [designationId], references: [id], onDelete: SetNull)
  manager            Employee?      @relation("ReportingHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates       Employee[]     @relation("ReportingHierarchy")
  managedDepartments Department[]   @relation("DepartmentManager")
  attendances        Attendance[]
  leaves             Leave[]
  managedProjects    Project[]          @relation("ProjectManager")
  projectMemberships ProjectMember[]
  assignedTasks      ProjectTask[]
  timeEntries        ProjectTimeEntry[]
  expenses           Expense[]
  salaryStructure    SalaryStructure?   @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)
  payslips           Payslip[]
  convertedApplicant JobApplicant?      @relation("ApplicantConvertedEmployee")
  interviews         ApplicantInterview[] @relation("EmployeeInterviews")

  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([departmentId])
  @@index([designationId])
  @@index([managerId])
  @@map("employees")
}

model Attendance {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  employeeId   String           @map("employee_id") @db.Uuid
  date         DateTime
  checkIn      DateTime?        @map("check_in")
  checkOut     DateTime?        @map("check_out")
  status       AttendanceStatus @default(PRESENT)
  workingHours Decimal?         @map("working_hours") @db.Decimal(5, 2)
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  // Relations
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, date])
  @@index([tenantId])
  @@index([employeeId])
  @@index([date])
  @@map("attendances")
}

model Leave {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  employeeId      String      @map("employee_id") @db.Uuid
  type            LeaveType   @default(CASUAL)
  startDate       DateTime    @map("start_date")
  endDate         DateTime    @map("end_date")
  days            Decimal     @db.Decimal(4, 1)
  reason          String
  status          LeaveStatus @default(PENDING)
  approvedById    String?     @map("approved_by_id") @db.Uuid
  approvedAt      DateTime?   @map("approved_at")
  rejectionReason String?     @map("rejection_reason")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@map("leaves")
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  PROBATION
  RESIGNED
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  LATE
  HOLIDAY
}

enum LeaveType {
  CASUAL
  SICK
  ANNUAL
  MATERNITY
  PATERNITY
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ============================================
// PROJECTS & TASKS DELIVERY
// ============================================

model Project {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  projectCode   String             @map("project_code")
  name          String
  description   String?
  status        ProjectStatus      @default(PLANNING)
  priority      ProjectPriority    @default(MEDIUM)
  startDate     DateTime?          @map("start_date")
  targetEndDate DateTime?          @map("target_end_date")
  actualEndDate DateTime?          @map("actual_end_date")
  budget        Decimal?           @db.Decimal(15, 2)
  currencyCode  String             @default("INR") @map("currency_code")
  clientId      String?            @map("client_id") @db.Uuid
  managerId     String?            @map("manager_id") @db.Uuid
  billingType   ProjectBillingType @default(FIXED_FEE) @map("billing_type")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client        Contact?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  manager       Employee?          @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  members       ProjectMember[]
  milestones    ProjectMilestone[]
  tasks         ProjectTask[]
  timeEntries   ProjectTimeEntry[]

  @@unique([tenantId, projectCode])
  @@index([tenantId])
  @@index([clientId])
  @@index([managerId])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  projectId  String    @map("project_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  role       String    @default("Team Member")
  hourlyRate Decimal?  @map("hourly_rate") @db.Decimal(10, 2)
  joinedAt   DateTime  @default(now()) @map("joined_at")

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
  @@index([tenantId])
  @@index([projectId])
  @@index([employeeId])
  @@map("project_members")
}

model ProjectMilestone {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  projectId     String          @map("project_id") @db.Uuid
  title         String
  description   String?
  dueDate       DateTime?       @map("due_date")
  completedDate DateTime?       @map("completed_date")
  status        MilestoneStatus @default(PENDING)
  deliverable   String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks         ProjectTask[]

  @@index([tenantId])
  @@index([projectId])
  @@index([status])
  @@map("project_milestones")
}

model ProjectTask {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  projectId          String            @map("project_id") @db.Uuid
  milestoneId        String?           @map("milestone_id") @db.Uuid
  taskCode           String            @map("task_code")
  title              String
  description        String?
  status             ProjectTaskStatus @default(TODO)
  priority           ProjectPriority   @default(MEDIUM)
  assignedEmployeeId String?           @map("assigned_employee_id") @db.Uuid
  estimatedHours     Decimal?          @map("estimated_hours") @db.Decimal(6, 2)
  actualHours        Decimal?          @default(0) @map("actual_hours") @db.Decimal(6, 2)
  startDate          DateTime?         @map("start_date")
  dueDate            DateTime?         @map("due_date")
  completedAt        DateTime?         @map("completed_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone          ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignedEmployee   Employee?         @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  timeEntries        ProjectTimeEntry[]

  @@unique([tenantId, taskCode])
  @@index([tenantId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([assignedEmployeeId])
  @@index([status])
  @@map("project_tasks")
}

model ProjectTimeEntry {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  taskId      String?      @map("task_id") @db.Uuid
  employeeId  String       @map("employee_id") @db.Uuid
  workDate    DateTime     @map("work_date")
  hours       Decimal      @db.Decimal(5, 2)
  description String
  isBillable  Boolean      @default(true) @map("is_billable")
