  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        ProjectTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([projectId])
  @@index([taskId])
  @@index([employeeId])
  @@map("project_time_entries")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectBillingType {
  FIXED_FEE
  TIME_AND_MATERIALS
  NON_BILLABLE
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum ProjectTaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

// ============================================
// RENTAL & LEASING MANAGEMENT
// ============================================

model RentalAsset {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  assetCode       String            @map("asset_code")
  name            String
  category        String
  serialNumber    String?           @map("serial_number")
  dailyRate       Decimal           @map("daily_rate") @db.Decimal(12, 2)
  weeklyRate      Decimal?          @map("weekly_rate") @db.Decimal(12, 2)
  monthlyRate     Decimal?          @map("monthly_rate") @db.Decimal(12, 2)
  securityDeposit Decimal           @default(0) @map("security_deposit") @db.Decimal(12, 2)
  condition       AssetCondition    @default(EXCELLENT)
  status          RentalAssetStatus @default(AVAILABLE)
  warehouseId     String?           @map("warehouse_id") @db.Uuid
  description     String?
  specifications  Json?             @default("{}")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse       Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
