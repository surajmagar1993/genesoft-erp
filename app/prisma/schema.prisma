// ============================================
// BANK RECONCILIATION
// ============================================

model BankAccount {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  accountName      String          @map("account_name") // e.g. "HDFC Main Corporate Current Account"
  accountNumber    String          @map("account_number") // e.g. "50200098765432"
  bankName         String          @map("bank_name") // e.g. "HDFC Bank"
  branchName       String?         @map("branch_name") // e.g. "Indiranagar, Bengaluru"
  ifscRoutingCode  String?         @map("ifsc_routing_code") // e.g. "HDFC0000240"
  swiftCode        String?         @map("swift_code")
  currencyCode     String          @default("INR") @map("currency_code")
  accountType      BankAccountType @default(CURRENT) @map("account_type")
  
  chartOfAccountId String?         @map("chart_of_account_id") @db.Uuid
  openingBalance   Decimal         @default(0) @map("opening_balance") @db.Decimal(15, 2)
  currentBalance   Decimal         @default(0) @map("current_balance") @db.Decimal(15, 2)
  
  isActive         Boolean         @default(true) @map("is_active")
  isPrimary        Boolean         @default(false) @map("is_primary")
  notes            String?
  
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chartOfAccount   Account?        @relation(fields: [chartOfAccountId], references: [id], onDelete: SetNull)
  statements       BankStatement[]
  transactions     BankTransaction[]

  @@unique([tenantId, accountNumber])
  @@index([tenantId])
  @@index([chartOfAccountId])
  @@index([isActive])
  @@map("bank_accounts")
}

model BankStatement {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  bankAccountId     String              @map("bank_account_id") @db.Uuid
  statementNumber   String              @map("statement_number") // e.g. "STMT-2026-03-HDFC"
  startDate         DateTime            @map("start_date")
  endDate           DateTime            @map("end_date")
  openingBalance    Decimal             @default(0) @map("opening_balance") @db.Decimal(15, 2)
  closingBalance    Decimal             @default(0) @map("closing_balance") @db.Decimal(15, 2)
  reconciledBalance Decimal             @default(0) @map("reconciled_balance") @db.Decimal(15, 2)
  status            BankStatementStatus @default(DRAFT)
  reconciledAt      DateTime?           @map("reconciled_at")
  notes             String?
  
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bankAccount       BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactions      BankTransaction[]

  @@unique([tenantId, statementNumber])
  @@index([tenantId])
  @@index([bankAccountId])
  @@index([status])
  @@map("bank_statements")
}

model BankTransaction {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  bankAccountId   String              @map("bank_account_id") @db.Uuid
  statementId     String?             @map("statement_id") @db.Uuid
  
  transactionDate DateTime            @map("transaction_date")
  valueDate       DateTime?           @map("value_date")
  type            BankTransactionType
  amount          Decimal             @db.Decimal(15, 2)
  balance         Decimal?            @db.Decimal(15, 2) // Running balance reported by bank
  payee           String?
  description     String              // Transaction memo / narration
  reference       String?             // Cheque No, UTR, Txn Ref, UPI Ref
  
  status          BankReconcileStatus @default(UNMATCHED)
  matchedType     BankMatchedType?    @map("matched_type")
  
  // Matched record pointers
  paymentId       String?             @map("payment_id")
  expenseId       String?             @map("expense_id") @db.Uuid
  journalEntryId  String?             @map("journal_entry_id") @db.Uuid
  
  matchedAt       DateTime?           @map("matched_at")
  reconciledAt    DateTime?           @map("reconciled_at")
  matchConfidence String?             @map("match_confidence") // "EXACT", "AMOUNT_ONLY", "RULE", "MANUAL"
  notes           String?
  
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bankAccount     BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  statement       BankStatement?      @relation(fields: [statementId], references: [id], onDelete: SetNull)
  payment         Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  expense         Expense?            @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  journalEntry    JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([bankAccountId])
  @@index([statementId])
  @@index([status])
  @@index([paymentId])
  @@index([expenseId])
  @@index([journalEntryId])
  @@map("bank_transactions")
}

enum BankAccountType {
  CURRENT
  SAVINGS
  CHECKING
  OVERDRAFT
  CREDIT_CARD
}

enum BankStatementStatus {
  DRAFT
  IN_PROGRESS
  RECONCILED
  ARCHIVED
}

enum BankTransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum BankReconcileStatus {
  UNMATCHED
  MATCHED
  RECONCILED
  EXCLUDED
}

enum BankMatchedType {
  PAYMENT
  EXPENSE
  JOURNAL_ENTRY
  MANUAL_ADJUSTMENT
}

// ============================================
// RECURRING INVOICES & SUBSCRIPTIONS
// ============================================

model RecurringProfile {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  profileNumber   String             @map("profile_number") // e.g. "REC-2026-0001"
  title           String             // e.g. "Monthly Cloud DevOps Retainer"
  description     String?
  contactId       String             @map("contact_id") @db.Uuid
  
  frequency       RecurringFrequency @default(MONTHLY)
  startDate       DateTime           @map("start_date")
  endDate         DateTime?          @map("end_date")
  nextRunDate     DateTime           @map("next_run_date")
  lastRunDate     DateTime?          @map("last_run_date")
  
  maxCycles       Int?               @map("max_cycles") // null = unlimited ongoing
  cyclesCompleted Int                @default(0) @map("cycles_completed")
  status          RecurringStatus    @default(ACTIVE)
  
  autoSendEmail   Boolean            @default(false) @map("auto_send_email")
  autoApprove     Boolean            @default(true) @map("auto_approve") // If true, invoice is created as SENT or PAID, else DRAFT
  paymentTerms    String?            @default("NET_30") @map("payment_terms")
  
  subtotal        Decimal            @default(0) @db.Decimal(15, 2)
  taxAmount       Decimal            @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount     Decimal            @default(0) @map("total_amount") @db.Decimal(15, 2)
  currencyCode    String             @default("INR") @map("currency_code")
  
  notes           String?
  terms           String?
  
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact         Contact            @relation(fields: [contactId], references: [id], onDelete: Restrict)
  items           RecurringProfileItem[]
  invoices        Invoice[]
  executions      RecurringExecution[]

  @@unique([tenantId, profileNumber])
  @@index([tenantId])
  @@index([contactId])
  @@index([status])
  @@index([nextRunDate])
  @@map("recurring_profiles")
}

model RecurringProfileItem {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  recurringProfileId String           @map("recurring_profile_id") @db.Uuid
  productId          String?          @map("product_id") @db.Uuid
  description        String
  hsnSacCode         String?          @map("hsn_sac_code")
  quantity           Decimal          @default(1) @db.Decimal(15, 2)
  unitPrice          Decimal          @map("unit_price") @db.Decimal(15, 2)
  
  cgstRate           Decimal?         @default(0) @map("cgst_rate") @db.Decimal(5, 2)
  cgstAmount         Decimal?         @default(0) @map("cgst_amount") @db.Decimal(15, 2)
  sgstRate           Decimal?         @default(0) @map("sgst_rate") @db.Decimal(5, 2)
  sgstAmount         Decimal?         @default(0) @map("sgst_amount") @db.Decimal(15, 2)
  igstRate           Decimal?         @default(0) @map("igst_rate") @db.Decimal(5, 2)
  igstAmount         Decimal?         @default(0) @map("igst_amount") @db.Decimal(15, 2)
  
  discount           Decimal          @default(0) @db.Decimal(15, 2)
  lineTotal          Decimal          @map("line_total") @db.Decimal(15, 2)
  
  createdAt          DateTime         @default(now()) @map("created_at")

  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recurringProfile   RecurringProfile @relation(fields: [recurringProfileId], references: [id], onDelete: Cascade)
  product            Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([recurringProfileId])
  @@index([productId])
  @@map("recurring_profile_items")
}

model RecurringExecution {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                   @map("tenant_id") @db.Uuid
  recurringProfileId String                   @map("recurring_profile_id") @db.Uuid
  invoiceId          String?                  @map("invoice_id")
  executionDate      DateTime                 @default(now()) @map("execution_date")
  status             RecurringExecutionStatus @default(SUCCESS)
  amount             Decimal                  @db.Decimal(15, 2)
  errorMessage       String?                  @map("error_message")
  
  createdAt          DateTime                 @default(now()) @map("created_at")

  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recurringProfile   RecurringProfile         @relation(fields: [recurringProfileId], references: [id], onDelete: Cascade)
  invoice            Invoice?                 @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([recurringProfileId])
  @@index([invoiceId])
  @@map("recurring_executions")
}

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  BIANNUALLY
  ANNUALLY
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum RecurringExecutionStatus {
  SUCCESS
  FAILED
}

