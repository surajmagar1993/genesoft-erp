  description     String?
  type            PriceListType     @default(SALES)
  currencyCode    String            @default("INR") @map("currency_code")
  
  pricingScheme   PricingScheme     @default(FIXED_OVERRIDE) @map("pricing_scheme")
  defaultDiscount Decimal           @default(0) @map("default_discount") @db.Decimal(5, 2) // % discount on unlisted items
  targetGroup     String?           @map("target_group") // ALL, RETAIL, WHOLESALE, ENTERPRISE, DISTRIBUTOR, VIP
  
