model CreditNote {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  creditNoteNumber String            @map("credit_note_number")
  contactId        String            @map("contact_id") @db.Uuid
  invoiceId        String?           @map("invoice_id")
  issueDate        DateTime          @default(now()) @map("issue_date")
  status           CreditNoteStatus  @default(ISSUED)
  reason           CreditNoteReason  @default(GOODS_RETURN)
  subtotal         Decimal           @default(0) @db.Decimal(15, 2)
  taxAmount        Decimal           @default(0) @map("tax_amount") @db.Decimal(15, 2)
  total            Decimal           @default(0) @db.Decimal(15, 2)
  allocatedAmount  Decimal           @default(0) @map("allocated_amount") @db.Decimal(15, 2)
  remainingBalance Decimal           @default(0) @map("remaining_balance") @db.Decimal(15, 2)
